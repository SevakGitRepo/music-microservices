# Database Configuration for Resource Service
RESOURCE_POSTGRES_DB=resource_db
RESOURCE_POSTGRES_USER=postgres
RESOURCE_POSTGRES_PASSWORD=postgres
RESOURCE_DB_URL=jdbc:postgresql://resource-postgres:5432/resource_db

# Database Configuration for Song Service
SONG_POSTGRES_DB=song_db
SONG_POSTGRES_USER=postgres
SONG_POSTGRES_PASSWORD=postgres
SONG_DB_URL=jdbc:postgresql://song-postgres:5432/song_db

# Service Communication
SONG_SERVICE_BASE_URL=http://api-gateway:8080
SONG_SERVICE_METADATA_ENDPOINT=/song-service/songs

# Eureka Service Discovery
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://service-registry:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=service-registry
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true
